{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts"]
}
