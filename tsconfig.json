{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"],
			"@tests/*": ["./tests/*"]
		}
	},
	// `standards/` is the source of truth. `plugin/standards/` is its committed
	// build copy — type-checking both would report every error twice.
	"include": ["src/**/*.ts", "tests/**/*.ts", "standards/**/*.ts"],
	"exclude": ["standards/**/fixtures/**", "plugin/standards/**"]
}
