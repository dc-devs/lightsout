{
	// The compiler options every package in this repo shares.
	//
	// Deliberately carries no `paths`, no `include` and no `exclude`: those are
	// the three things that are genuinely per-package, and a base that guessed at
	// them would be overridden everywhere it was used.
	//
	// No `composite` and no project references. References require declaration
	// emit, and `allowImportingTsExtensions` below cannot coexist with emit — but
	// that flag is what lets a rule's check.ts import '../../common/utils/x.ts',
	// which is the specifier Node's type stripping needs when the engine loads
	// that file from plugin/standards/ on a consumer's machine. References would
	// break how standards ship in order to speed up a `tsc --noEmit` that already
	// takes seconds. Cross-package imports resolve through the package manager's
	// links and each package's `exports` field instead, which is also how esbuild
	// resolves them.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	}
}
