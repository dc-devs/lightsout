# deps
node_modules/

# build artifacts — NOTE: dist/ is deliberately NOT ignored.
# The bundled engine (dist/cli.mjs) is committed by design: the plugin
# distribution model is a git clone with no install hook, so the runnable
# artifact must ship in the repo.
*.tsbuildinfo
.test-dist/

# os / editor
.DS_Store
*.log

# fixture run state
fixtures/*/.lightsout/runs/
fixtures/*/.lightsout/friction.jsonl

# local-only personal notes — never committed
.notes
