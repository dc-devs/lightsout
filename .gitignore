# deps
node_modules/

# build artifacts — NOTE: plugin/dist/ is deliberately NOT ignored.
# The bundled engine (plugin/dist/cli.mjs) is committed by design: there is
# no install hook, so the runnable artifact must ship in the repo — and it
# must live INSIDE plugin/ because marketplace installs copy only the plugin
# source directory.
*.tsbuildinfo
.test-dist/
coverage/
# ...but the coverage PIPELINE is source, not a report. The bare pattern above
# matches a `coverage` directory at ANY depth, which silently swallowed the
# whole `lightsout test-coverage-to-threshold` module.
!src/coverage/
!src/contracts/coverage/

# os / editor
.DS_Store
*.log

# fixture run state
fixtures/*/.lightsout/runs/
fixtures/*/.lightsout/friction.jsonl

# own run state (this repo is its own lightsout consumer)
.lightsout/runs/
.lightsout/plans/
.lightsout/standards-check.json
.lightsout/lock.json
.lightsout/friction.jsonl
.lightsout/voice-on
.lightsout/voice-pid

# legacy plan location — plans written before plans moved into .lightsout/
.claude/plans

# fdrop plugin hook artifacts
.fdrop/

.notes/
