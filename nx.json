{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",

	"defaultBase": "main",

	// Gates must run offline, and checkShipped must prove plugin/dist rebuilds from source.
	"neverConnectToCloud": true,

	"parallel": 2,

	// lightsout reads gate output back as text, so no screen-redrawing UI.
	"tui": { "enabled": false },

	"namedInputs": {
		// Fixtures are inputs: a rule's unit test reads them. coverage/ is output.
		"default": ["{projectRoot}/**/*", "!{projectRoot}/coverage/**/*", "sharedGlobals"],
		"sharedGlobals": [
			"{workspaceRoot}/tsconfig.base.json",
			"{workspaceRoot}/tooling/jest/**/*",
			"{workspaceRoot}/biome.jsonc",
			"{workspaceRoot}/pnpm-lock.yaml"
		],
		// Mirrors the filter in scripts/copyStandards.mjs; change both together.
		"production": [
			"default",
			"!{projectRoot}/**/*.unit.test.ts",
			"!{projectRoot}/**/*.test.ts",
			"!{projectRoot}/**/fixtures/**/*",
			"!{projectRoot}/jest.config.cjs",
			"!{projectRoot}/jest.e2e.config.cjs",
			"!{projectRoot}/tsconfig.jest.json",
			"!{projectRoot}/README.md"
		]
	},

	// No caching: a cached green is not evidence that a gate ran.
	"targetDefaults": {
		// Packages ship source, so a target depends on its dependencies' files, not their builds.
		"typecheck": { "cache": false, "inputs": ["default", "^default"] },
		// One Jest suite at a time, so one worker pool (maxWorkers) holds the machine.
		"test:unit": { "cache": false, "parallelism": false, "inputs": ["default", "^default"] },
		"test:unit:coverage": {
			"cache": false,
			"parallelism": false,
			"inputs": ["default", "^default"],
			"outputs": ["{projectRoot}/coverage"]
		},
		"test:e2e": {
			"cache": false,
			"inputs": ["default", "^default", { "externalDependencies": ["esbuild"] }]
		},
		"build": {
			"cache": false,
			"inputs": ["default", "^default"],
			"outputs": ["{projectRoot}/dist"]
		},
		"bundle": {
			"cache": false,
			"inputs": ["production", "^production", { "externalDependencies": ["esbuild"] }]
		}
	},

	"analytics": false
}
