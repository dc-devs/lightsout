{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// A browser package needs the DOM and JSX; everything else it inherits.
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"jsx": "react-jsx",
		"types": ["node", "@testing-library/jest-dom/jest-globals"],
		"baseUrl": ".",
		// The two repo-root folders this app reads: assets/, where every shipped
		// graphic and its data file lives so the README and this app read one
		// copy, and docs/, whose markdown the /docs pages render. Neither can be
		// a `#…/*` entry in package.json `imports`: Node, TypeScript and esbuild
		// all reject an `imports` target that escapes the package
		// (ERR_INVALID_PACKAGE_TARGET). So each alias is declared three times —
		// here, in vite.config.ts, and in jest.config.cjs — and the three have
		// to agree.
		"paths": { "#assets/*": ["../../assets/*"], "#docs/*": ["../../docs/*"] }
	},
	// tests/ is typechecked and reached through `#tests/*`: shared test support
	// may not live under src/, so the helpers have nowhere else to go.
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "tests/**/*.ts", "tests/**/*.tsx"],
	// Restated because naming `exclude` at all replaces TypeScript's default, and
	// `src/**` would otherwise sweep the symlinked dependency tree.
	"exclude": ["node_modules"]
}
