{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

	// Ignored paths come from .gitignore rather than being restated here —
	// coverage/, .test-dist/, node_modules/, .lightsout/.
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

	"files": {
		"includes": [
			"**",
			// A standards rule ships pass/fail example folders, and the whole job
			// of fixtures/fail/ is to hold code that breaks the rule. Linting them
			// would fail the gate on purpose-built bad examples, and formatting
			// them could quietly change what the example proves.
			"!**/fixtures",
			// Generated. esbuild owns plugin/dist/, scripts/copyStandards.mjs owns
			// plugin/standards/, and CI proves both match source by rebuilding and
			// diffing. Formatting them here would make that check fail forever.
			"!plugin/dist",
			"!plugin/standards",
			// Diagram sources and their exports — authored by the flow-graphic
			// tooling, not by hand.
			"!assets",
			// Harness configuration and skills, not this project's source. The
			// files in here belong to the tools that read them.
			"!.claude"
		]
	},

	// Tabs, single quotes, and a wide line at 160: the settings the repo was
	// already written in. 160 is also where one-time reformatting churn bottoms
	// out — 120 doubles it, and wider settings raise it again because Biome
	// rejoins lines that were hand-wrapped.
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 160 },
	"javascript": { "formatter": { "quoteStyle": "single" } },

	"assist": { "actions": { "source": { "organizeImports": "on" } } },

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// useImportType and noExplicitAny are named explicitly even though
			// `recommended` already turns them on. src/doctor/checkLintRules.ts
			// reads this file as raw text and looks for these two names, because
			// the standards state them as binding. Leave them implicit and
			// lightsout's own doctor reports this repo as unenforced.
			"style": { "useImportType": "error" },
			"suspicious": { "noExplicitAny": "error" }
		}
	},

	"overrides": [
		{
			// Nx parses nx.json as JSON-with-comments, and this repo uses that to
			// document non-obvious cache decisions in place. Without this, Biome
			// treats .json as strict and strips or rejects those comments.
			"includes": ["nx.json"],
			"json": { "parser": { "allowComments": true } }
		},
		{
			// A check takes source text and reads it as code, so its tests feed it
			// code as a plain string — and code that builds a string contains
			// `${...}`. Every one of the 30 sites this rule found was that, and
			// none were outside a test. Off here, still on everywhere else, where
			// a `${...}` in a plain string really is a forgotten backtick.
			"includes": ["**/*.test.ts"],
			"linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
		}
	]
}
