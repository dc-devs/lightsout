{
	"name": "lightsout",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Deterministic engine for coding agents — the accountability shell that lets the factory run with the lights off.",
	"license": "MIT",
	"author": "David Christian",
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"lint": "biome check .",
		"check": "pnpm lint && tsc --noEmit",
		"format": "biome check --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "jest -c tests/config/jest.config.cjs",
		"test:unit:coverage": "jest -c tests/config/jest.config.cjs --coverage --passWithNoTests",
		"test:e2e": "jest -c tests/config/jest.e2e.config.cjs",
		"bundle": "pnpm bundle:engine && pnpm bundle:standards",
		"bundle:engine": "node scripts/buildEngine.mjs",
		"bundle:standards": "node scripts/copyStandards.mjs",
		"check:shipped": "node scripts/checkShipped.mjs",
		"lightsout": "node  plugin/dist/cli.mjs"
	},
	"dependencies": {
		"yaml": "^2.9.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@jest/globals": "^30.4.1",
		"@jscpd/core": "^4.2.5",
		"@jscpd/tokenizer": "^4.2.5",
		"@types/node": "^22.10.0",
		"esbuild": "^0.24.0",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.12",
		"typescript": "^5.7.0"
	}
}
